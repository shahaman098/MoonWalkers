# SwarmOS GCP Backend - Environment Variables
# Copy to .env and adjust as needed.

# GCP Configuration
GCP_PROJECT_ID=gdm-hacks2603-lon-2812
GCP_PROJECT_NUMBER=980802873588
GCP_REGION=europe-west2

# API Authentication
# Generate your own: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SWARM_API_KEY=REPLACE_ME_WITH_A_REAL_TOKEN

# Workspace settings
WORKSPACE_ROOT=/tmp/swarm-os-gcp/workspaces

# URL overrides (auto-derived from project if not set)
# BASE_URL=https://swarm-os-api-980802873588.europe-west2.run.app
# STREAM_URL=wss://swarm-os-api-980802873588.europe-west2.run.app
# SYNC_URL=wss://swarm-os-api-980802873588.europe-west2.run.app

# Safety limits
AUTO_KILL_DEFAULT=30          # minutes before workspace is force-killed
EXEC_TIMEOUT=300              # seconds per command execution
COST_PER_HOUR=0.085714        # estimated $/hr for e2-medium spot

# Stream
STREAM_HEARTBEAT=5            # seconds between WebSocket heartbeats

# Service accounts
SA_API=swarm-api@gdm-hacks2603-lon-2812.iam.gserviceaccount.com
SA_WORKER=swarm-worker@gdm-hacks2603-lon-2812.iam.gserviceaccount.com
